meta {
  name: Edit Pipeline Stage
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/pipeline-stages/:stage_id
  body: json
  auth: bearer
}

params:path {
  stage_id: {{stage_id}}
}

script:pre-request {
  try {
    let pathId = null;
    if (typeof req.getPathVar === 'function') {
      pathId = req.getPathVar("stage_id");
    } else if (typeof req.getPathVariable === 'function') {
      pathId = req.getPathVariable("stage_id");
    } else if (req.pathVariables && req.pathVariables.stage_id) {
      pathId = req.pathVariables.stage_id;
    }
    if (pathId && !pathId.toString().includes("{{")) {
      bru.setVar("stage_id", pathId);
      bru.setEnvVar("stage_id", pathId);
    }
  } catch (e) {}
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "stage_name": "Technical & Security Review",
    "display_order": 4
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Stage updated successfully", function () {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.data.stage).to.be.an('object');
    expect(data.data.stage.stage_name).to.equal('Technical & Security Review');
  });
}
