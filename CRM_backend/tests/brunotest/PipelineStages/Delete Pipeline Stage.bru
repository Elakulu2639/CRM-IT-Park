meta {
  name: Delete Pipeline Stage
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/pipeline-stages/:stage_id
  body: none
  auth: bearer
}

params:path {
  stage_id: {{stage_id}}
}

script:pre-request {
  try {
    let pathId = null;
    if (typeof req.getPathVar === 'function') {
      pathId = req.getPathVar("stage_id");
    } else if (typeof req.getPathVariable === 'function') {
      pathId = req.getPathVariable("stage_id");
    } else if (req.pathVariables && req.pathVariables.stage_id) {
      pathId = req.pathVariables.stage_id;
    }
    if (pathId && !pathId.toString().includes("{{")) {
      bru.setVar("stage_id", pathId);
      bru.setEnvVar("stage_id", pathId);
    }
  } catch (e) {}
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200 on successful delete", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Stage deleted message", function () {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.message).to.include('deleted');
  });
}
