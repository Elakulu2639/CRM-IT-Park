meta {
  name: Delete Pipeline Stage
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/pipeline-stages/{{stage_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200 on successful delete", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Stage deleted message", function () {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.message).to.include('deleted');
  });
}
