meta {
  name: Change User Status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/users/:user_id/status
  body: json
  auth: bearer
}

params:path {
  user_id: {{user_id}}
}

script:pre-request {
  try {
    let pathId = null;
    if (typeof req.getPathVar === 'function') {
      pathId = req.getPathVar("user_id");
    } else if (typeof req.getPathVariable === 'function') {
      pathId = req.getPathVariable("user_id");
    } else if (req.pathVariables && req.pathVariables.user_id) {
      pathId = req.pathVariables.user_id;
    }
    if (pathId && !pathId.toString().includes("{{")) {
      bru.setVar("user_id", pathId);
      bru.setEnvVar("user_id", pathId);
    }
  } catch (e) {}
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "status": "inactive"
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("User status updated successfully", function () {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.data.user.status).to.equal('inactive');
  });
}
