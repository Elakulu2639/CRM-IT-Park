meta {
  name: Edit User
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/users/:user_id
  body: json
  auth: bearer
}

params:path {
  user_id: {{user_id}}
}

script:pre-request {
  try {
    let pathId = null;
    if (typeof req.getPathVar === 'function') {
      pathId = req.getPathVar("user_id");
    } else if (typeof req.getPathVariable === 'function') {
      pathId = req.getPathVariable("user_id");
    } else if (req.pathVariables && req.pathVariables.user_id) {
      pathId = req.pathVariables.user_id;
    }
    if (pathId && !pathId.toString().includes("{{")) {
      bru.setVar("user_id", pathId);
      bru.setEnvVar("user_id", pathId);
    }
  } catch (e) {}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "role_id": 2,
    "first_name": "Dawit Updated",
    "last_name": "Tesfaye",
    "email": "dawit.updated@itpark.gov.et",
    "phone": "+251900000001",
    "status": "active"
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("User updated successfully", function () {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.data.user).to.be.an('object');
  });
}
