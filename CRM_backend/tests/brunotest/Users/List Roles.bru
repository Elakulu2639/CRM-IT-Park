meta {
  name: List Roles
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Returns list of active roles", function () {
    const data = res.getBody();
    expect(data.data).to.be.an('array');
    expect(data.data.length).to.be.greaterThan(0);
    expect(data.data[0]).to.have.property('role_name');
  });
}
