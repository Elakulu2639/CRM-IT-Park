meta {
  name: Get Ticket Category
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/ticket-categories/{{category_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Category details returned", function () {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data.ticket_category).to.be.an('object');
    expect(body.data.ticket_category.id).to.equal(bru.getEnvVar("category_id"));
  });
}
