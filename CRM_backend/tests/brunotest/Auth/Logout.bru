meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Logged out successfully and token cleared", function () {
    const data = res.getBody();
    expect(data.success).to.be.true;
    
    bru.setEnvVar("token", "");
    bru.setVar("token", "");
  });
}
