meta {
  name: Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("User profile and role loaded", function () {
    const data = res.getBody();
    expect(data.success).to.be.true;
    expect(data.data.user).to.be.an('object');
    expect(data.data.user.email).to.be.a('string');
  });
}
