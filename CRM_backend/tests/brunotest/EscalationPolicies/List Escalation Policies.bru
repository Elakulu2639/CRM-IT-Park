meta {
  name: List Escalation Policies
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/escalation-policies
  body: none
  auth: bearer
}

params:query {
  ~priority: Medium
  ~active_only: true
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Returns array of escalation policies", function () {
    const data = res.getBody();
    expect(data.data).to.be.an('array');
    if (data.data.length > 0) {
      expect(data.data[0]).to.have.property('id');
      expect(data.data[0]).to.have.property('priority');
      expect(data.data[0]).to.have.property('reminder_threshold_minutes');
      expect(data.data[0]).to.have.property('escalation_threshold_minutes');
      expect(data.data[0]).to.have.property('is_active');
      
      // Auto-populate policy_id environment variable from the first policy if not set
      if (!bru.getEnvVar("policy_id")) {
        bru.setEnvVar("policy_id", data.data[0].id);
      }
    }
  });
}
