[
    {
        "name": "List Users",
        "event": [
            {
                "listen": "test",
                "script": {
                    "exec": [
                        "pm.test(\"Status code is 200\", function () {",
                        "    pm.response.to.have.status(200);",
                        "});",
                        "",
                        "pm.test(\"Returns array of users with roles\", function () {",
                        "    var jsonData = pm.response.json();",
                        "    pm.expect(jsonData.data).to.be.an('array');",
                        "    if (jsonData.data.length > 0) {",
                        "        pm.expect(jsonData.data[0]).to.have.property('id');",
                        "        pm.expect(jsonData.data[0]).to.have.property('status');",
                        "        pm.expect(jsonData.data[0]).to.have.property('role');",
                        "        pm.environment.set('test_user_id', jsonData.data[0].id);",
                        "    }",
                        "});"
                    ],
                    "type": "text/javascript"
                }
            }
        ],
        "request": {
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{token}}",
                        "type": "string"
                    }
                ]
            },
            "method": "GET",
            "header": [
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "url": {
                "raw": "{{baseUrl}}/users",
                "host": [
                    "{{baseUrl}}"
                ],
                "path": [
                    "users"
                ]
            },
            "description": "Returns list of all CRM users with status and role. Requires System Administrator role."
        },
        "response": []
    },
    {
        "name": "Create User",
        "event": [
            {
                "listen": "test",
                "script": {
                    "exec": [
                        "pm.test(\"Status code is 201\", function () {",
                        "    pm.response.to.have.status(201);",
                        "});",
                        "",
                        "pm.test(\"User created with correct role\", function () {",
                        "    var jsonData = pm.response.json();",
                        "    pm.expect(jsonData.success).to.be.true;",
                        "    pm.expect(jsonData.data.user.email).to.be.a('string');",
                        "    pm.expect(jsonData.data.user.status).to.eql('active');",
                        "    pm.expect(jsonData.data.user.role).to.be.an('object');",
                        "    pm.environment.set('new_user_id', jsonData.data.user.id);",
                        "});"
                    ],
                    "type": "text/javascript"
                }
            }
        ],
        "request": {
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{token}}",
                        "type": "string"
                    }
                ]
            },
            "method": "POST",
            "header": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "body": {
                "mode": "raw",
                "raw": "{\n  \"role_id\": 2,\n  \"first_name\": \"Dawit\",\n  \"last_name\": \"Tesfaye\",\n  \"email\": \"dawit.tesfaye@itpark.gov.et\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"phone\": \"+251912345678\"\n}",
                "options": {
                    "raw": {
                        "language": "json"
                    }
                }
            },
            "url": {
                "raw": "{{baseUrl}}/users",
                "host": [
                    "{{baseUrl}}"
                ],
                "path": [
                    "users"
                ]
            },
            "description": "Creates a new CRM user with the specified role. Requires System Administrator role."
        },
        "response": []
    },
    {
        "name": "Edit User",
        "event": [
            {
                "listen": "test",
                "script": {
                    "exec": [
                        "pm.test(\"Status code is 200\", function () {",
                        "    pm.response.to.have.status(200);",
                        "});",
                        "",
                        "pm.test(\"User updated successfully\", function () {",
                        "    var jsonData = pm.response.json();",
                        "    pm.expect(jsonData.success).to.be.true;",
                        "    pm.expect(jsonData.data.user).to.be.an('object');",
                        "});"
                    ],
                    "type": "text/javascript"
                }
            }
        ],
        "request": {
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{token}}",
                        "type": "string"
                    }
                ]
            },
            "method": "PUT",
            "header": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "body": {
                "mode": "raw",
                "raw": "{\n  \"role_id\": 2,\n  \"first_name\": \"Dawit Updated\",\n  \"last_name\": \"Tesfaye\",\n  \"email\": \"dawit.updated@itpark.gov.et\",\n  \"phone\": \"+251900000001\",\n  \"status\": \"active\"\n}",
                "options": {
                    "raw": {
                        "language": "json"
                    }
                }
            },
            "url": {
                "raw": "{{baseUrl}}/users/{{user_id}}",
                "host": [
                    "{{baseUrl}}"
                ],
                "path": [
                    "users",
                    "{{user_id}}"
                ],
                "variable": [
                    {
                        "key": "user_id",
                        "value": "{{new_user_id}}",
                        "description": "ID of the user to edit (change to edit any user)"
                    }
                ]
            },
            "description": "Updates any user information (first_name, last_name, email, phone, role_id, status, password) by specifying user ID in the path. Requires System Administrator role."
        },
        "response": []
    },
    {
        "name": "Change User Status",
        "event": [
            {
                "listen": "test",
                "script": {
                    "exec": [
                        "pm.test(\"Status code is 200\", function () {",
                        "    pm.response.to.have.status(200);",
                        "});",
                        "",
                        "pm.test(\"User status updated successfully\", function () {",
                        "    var jsonData = pm.response.json();",
                        "    pm.expect(jsonData.success).to.be.true;",
                        "    pm.expect(jsonData.data.user.status).to.eql('inactive');",
                        "});"
                    ],
                    "type": "text/javascript"
                }
            }
        ],
        "request": {
            "auth": {
                "type": "bearer",
                "bearer": [
                    {
                        "key": "token",
                        "value": "{{token}}",
                        "type": "string"
                    }
                ]
            },
            "method": "PATCH",
            "header": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                },
                {
                    "key": "Accept",
                    "value": "application/json"
                }
            ],
            "body": {
                "mode": "raw",
                "raw": "{\n  \"status\": \"inactive\"\n}",
                "options": {
                    "raw": {
                        "language": "json"
                    }
                }
            },
            "url": {
                "raw": "{{baseUrl}}/users/{{user_id}}/status",
                "host": [
                    "{{baseUrl}}"
                ],
                "path": [
                    "users",
                    "{{user_id}}",
                    "status"
                ],
                "variable": [
                    {
                        "key": "user_id",
                        "value": "{{new_user_id}}",
                        "description": "ID of the user whose status to toggle"
                    }
                ]
            },
            "description": "Updates user status to either 'active' or 'inactive'. Revokes tokens when deactivating. Requires System Administrator role."
        },
        "response": []
    },
